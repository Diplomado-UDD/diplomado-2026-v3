# Copia este archivo como .env en esta carpeta y completa las claves. Nunca subas .env al repositorio.

# Clave de la API de Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith: crea la clave en https://smith.langchain.com, en Settings, API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=clase-09-agentes

# Solo si tu cuenta de LangSmith está en la región de la Unión Europea
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Solo si tu clave de LangSmith tiene acceso a varios workspaces
# LANGSMITH_WORKSPACE_ID=
